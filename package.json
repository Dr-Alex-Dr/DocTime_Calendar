{
  "name": "my-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"lcp --proxyUrl https://64v.ru\" \"vite\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky && husky install",
    "contract:schedule": "mkdir -p ./src/shared/api/schedule && npx swagger-typescript-api -p https://64v.ru/api/v1/openapi.json -o ./src/shared/api/schedule -t ./src/shared/config/template --modular --axios --type-prefix I && node ./src/shared/config/template/cleansСontracts.js",
    "e2e-tests": "npx playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/material": "^6.1.7",
    "axios": "^1.7.7",
    "classnames": "^2.5.1",
    "mobx": "^6.13.5",
    "mobx-react": "^9.1.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "react": "^18.3.1",
    "react-big-calendar": "^1.15.0",
    "react-day-picker": "^9.5.0",
    "react-dom": "^18.3.1",
    "swagger-typescript-api": "^12.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.10",
    "@types/react-big-calendar": "^1.15.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.3",
    "sass": "^1.83.0",
    "sass-embedded": "^1.81.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
